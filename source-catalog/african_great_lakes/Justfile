# Source preparation pipeline to be run from the pipelines folder
[no-cd]
default:
    pixi run --script source_download.py african_great_lakes
    pixi run --script source_unzip.py african_great_lakes
    pixi run --script source_to_4326.py african_great_lakes
    pixi run --script source_bounds.py african_great_lakes
    pixi run --script source_polygonize.py african_great_lakes 32
    pixi run --script source_create_tarball.py african_great_lakes
