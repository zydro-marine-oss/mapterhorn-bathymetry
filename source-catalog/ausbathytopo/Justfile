# Source preparation pipeline to be run from the pipelines folder
[no-cd]
default:
    pixi run --script source_download.py ausbathytopo
    pixi run --script source_unzip.py ausbathytopo
    pixi run --script source_to_4326.py ausbathytopo
    pixi run --script source_bounds.py ausbathytopo
    pixi run --script source_polygonize.py ausbathytopo 32
    pixi run --script source_create_tarball.py ausbathytopo
