# Source preparation pipeline to be run from the pipelines folder
[no-cd]
default:
    pixi run --script source_download.py bodensee
    pixi run --script source_unzip.py bodensee
    pixi run --script source_to_4326.py bodensee
    pixi run --script source_bounds.py bodensee
    pixi run --script source_polygonize.py bodensee 32
    pixi run --script source_create_tarball.py bodensee
