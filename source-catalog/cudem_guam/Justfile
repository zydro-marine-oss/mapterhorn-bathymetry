# Source preparation pipeline to be run from the pipelines folder
[no-cd]
default:
    pixi run --script source_download.py cudem_guam
    pixi run --script source_to_4326.py cudem_guam
    pixi run --script source_bounds.py cudem_guam
    pixi run --script source_polygonize.py cudem_guam 32
    pixi run --script source_create_tarball.py cudem_guam
