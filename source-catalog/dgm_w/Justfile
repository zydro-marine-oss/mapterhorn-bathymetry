# Source preparation pipeline to be run from the pipelines folder
[no-cd]
default:
    pixi run --script source_download.py dgm_w
    pixi run --script source_unzip.py dgm_w
    pixi run --script source_to_4326.py dgm_w
    pixi run --script source_bounds.py dgm_w
    pixi run --script source_polygonize.py dgm_w 32
    pixi run --script source_create_tarball.py dgm_w
