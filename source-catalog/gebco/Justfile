# Source preparation pipeline to be run from mapterhorn/pipelines folder
[no-cd]
default:
    pixi run --script source_download.py gebco
    pixi run --script source_normalize_filenames.py gebco
    pixi run --script source_bounds.py gebco
    pixi run --script source_polygonize.py gebco 32
    pixi run --script source_create_tarball.py gebco
