# Source preparation pipeline to be run from the pipelines folder
[no-cd]
default:
    pixi run --script source_download.py kartverket_50m
    pixi run --script source_unzip.py kartverket_50m
    pixi run --script source_to_4326.py kartverket_50m
    pixi run --script source_bounds.py kartverket_50m
    pixi run --script source_polygonize.py kartverket_50m 32
    pixi run --script source_create_tarball.py kartverket_50m
