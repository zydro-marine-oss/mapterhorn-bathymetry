# Source preparation pipeline to be run from the pipelines folder
[no-cd]
default:
    pixi run --script source_download.py swiobc
    pixi run --script source_to_4326.py swiobc
    pixi run --script source_bounds.py swiobc
    pixi run --script source_polygonize.py swiobc 32
    pixi run --script source_create_tarball.py swiobc
