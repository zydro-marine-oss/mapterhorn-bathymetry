# Source preparation pipeline to be run from the pipelines folder
[no-cd]
default:
    pixi run --script source_download.py uk_surfzone
    pixi run --script source_unzip.py uk_surfzone
    pixi run --script source_to_4326.py uk_surfzone
    pixi run --script source_bounds.py uk_surfzone
    pixi run --script source_polygonize.py uk_surfzone 32
    pixi run --script source_create_tarball.py uk_surfzone
